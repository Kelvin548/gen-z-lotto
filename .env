# APP ENVIRONMENT
NODE_ENV="development"
APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3000/admin"

# REAL-MONEY ACTIVATION GATES
ENABLE_REAL_MONEY_TRANSACTIONS="false"
PAYMENT_PROVIDER_MODE="SANDBOX"

# DATABASE (XAMPP / MySQL Local Instance)
DATABASE_URL="mysql://root:@localhost:3306/gen_z_lotto"

# AUTHENTICATION & SECURITY
AUTH_SECRET="super-secret-at-least-32-characters-long"
NEXTAUTH_SECRET="super-secret-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"
SESSION_EXPIRE_HOURS="24"

# OTP PROVIDER (SANDBOX/MOCK IN DEV)
OTP_PROVIDER="SANDBOX"
OTP_API_KEY="placeholder_otp_key"

# PAYMENT PROVIDERS & WEBHOOKS (SANDBOX IN DEV)
PAYSTACK_SECRET_KEY="sk_test_placeholder_key"
MTN_MOMO_API_KEY="placeholder_momo_key"
MTN_MOMO_API_SECRET="placeholder_momo_secret"
MTN_MOMO_SUBSCRIPTION_KEY="placeholder_momo_sub_key"
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"

# REDIS (RATE LIMITING / SESSION CACHE)
REDIS_URL="redis://localhost:6379"