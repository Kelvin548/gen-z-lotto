datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  SELF_EXCLUDED
  DEACTIVATED
}

enum AccountType {
  USER_WALLET
  EXTERNAL_PAYMENT_GATEWAY
  GAME_STAKE_POOL
  GAME_WINNINGS_POOL
  PLATFORM_REVENUE
}

enum TicketStatus {
  PENDING
  ACTIVE
  WON
  LOST
  CANCELLED
  REFUNDED
}

enum DrawStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  RESULT_PENDING
  RESULT_PUBLISHED
  CANCELLED
}

// ==========================================
// PHASE 5: FINANCIAL & LEDGER ENUMS
// ==========================================

enum WalletStatus {
  ACTIVE
  SUSPENDED
  FROZEN
  CLOSED
}

enum FinancialTransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_REFUND
  WINNING_CREDIT
  ADMIN_ADJUSTMENT
  REVERSAL
}

enum FinancialTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

// ==========================================
// USER & IDENTITY MODELS
// ==========================================

model User {
  id                  String             @id @default(uuid())
  phoneNumber         String             @unique @map("phone_number")
  email               String?            @unique
  passwordHash        String             @map("password_hash")
  status              UserStatus         @default(PENDING_VERIFICATION)
  isPhoneVerified     Boolean            @default(false) @map("is_phone_verified")
  failedLoginAttempts Int                @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?          @map("locked_until")
  termsAcceptedAt     DateTime           @map("terms_accepted_at")
  privacyAcceptedAt   DateTime           @map("privacy_accepted_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  profile             UserProfile?
  wallet              Wallet?
  sessions            UserSession[]
  otpVerifications    OTPVerification[]
  tickets             Ticket[]
  deposits            Deposit[]
  withdrawals         Withdrawal[]
  limits              ResponsibleGamingLimit[]
  selfExclusions      SelfExclusion[]

  @@map("users")
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  fullName    String    @map("full_name")
  dateOfBirth DateTime? @map("date_of_birth")
  idNumber    String?   @map("id_number")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model OTPVerification {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  phoneNumber String   @map("phone_number")
  codeHash    String   @map("code_hash")
  purpose     String   @default("REGISTRATION") // REGISTRATION, PASSWORD_RESET
  attempts    Int      @default(0)
  isVerified  Boolean  @default(false) @map("is_verified")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_verifications")
}

// ==========================================
// PHASE 5: FINANCIAL & LEDGER MODELS
// ==========================================

model Wallet {
  id                    String       @id @default(uuid())
  userId                String       @unique @map("user_id")
  availableBalanceMinor BigInt       @default(0) @map("available_balance_minor") // Integer minor units (Pesewas)
  heldBalanceMinor      BigInt       @default(0) @map("held_balance_minor") // Integer minor units (Pesewas)
  currency              String       @default("GHS")
  status                WalletStatus @default(ACTIVE)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  deposits      Deposit[]

  @@index([userId])
  @@map("wallets")
}

model FinancialTransaction {
  id              String                     @id @default(uuid())
  type            FinancialTransactionType
  status          FinancialTransactionStatus @default(PENDING)
  amountMinor     BigInt                     @map("amount_minor") // Total transaction amount in minor units
  currency        String                     @default("GHS")
  reference       String                     @unique
  providerRef     String?                    @map("provider_ref")
  paymentProvider String?                    @map("payment_provider")
  idempotencyKey  String?                    @unique @map("idempotency_key")
  metadata        Json?
  actorId         String?                    @map("actor_id") // User ID or Admin ID
  ticketId        String?                    @map("ticket_id") // Optional link to associated ticket
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]
  auditLogs     FinancialAuditLog[]
  deposit       Deposit?
  withdrawal    Withdrawal?

  @@index([type])
  @@index([status])
  @@index([idempotencyKey])
  @@map("financial_transactions")
}

model LedgerEntry {
  id            String               @id @default(uuid())
  transactionId String               @map("transaction_id")
  walletId      String?              @map("wallet_id") // Nullable for system accounts
  direction     LedgerEntryDirection
  amountMinor   BigInt               @map("amount_minor") // Positive integer minor units
  currency      String               @default("GHS")
  description   String
  createdAt     DateTime             @default(now()) @map("created_at")

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  wallet      Wallet?              @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([walletId])
  @@map("ledger_entries")
}

model FinancialAuditLog {
  id            String   @id @default(uuid())
  transactionId String?  @map("transaction_id")
  actorId       String?  @map("actor_id")
  action        String
  target        String?
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  transaction FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([actorId])
  @@map("financial_audit_logs")
}

// ==========================================
// GAME ENGINE & TICKET MODELS
// ==========================================

model Game {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  gameTypes GameType[]
  draws     Draw[]

  @@map("games")
}

model GameType {
  id           String  @id @default(uuid())
  gameId       String  @map("game_id")
  name         String
  slug         String
  minSelection Int     @map("min_selection")
  maxSelection Int     @map("max_selection")
  multiplier   Decimal @db.Decimal(10, 2)
  isActive     Boolean @default(true) @map("is_active")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, slug])
  @@map("game_types")
}

model Draw {
  id            String     @id @default(uuid())
  gameId        String     @map("game_id")
  drawNumber    String     @unique @map("draw_number")
  scheduledAt   DateTime   @map("scheduled_at")
  closedAt      DateTime?  @map("closed_at")
  status        DrawStatus @default(DRAFT)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  game          Game          @relation(fields: [gameId], references: [id])
  winningNumber WinningNumber?
  tickets       Ticket[]

  @@map("draws")
}

model WinningNumber {
  id          String   @id @default(uuid())
  drawId      String   @unique @map("draw_id")
  numbers     Json     @map("numbers")
  publishedAt DateTime @default(now()) @map("published_at")

  draw Draw @relation(fields: [drawId], references: [id], onDelete: Cascade)

  @@map("winning_numbers")
}

model Ticket {
  id              String       @id @default(uuid())
  ticketNumber    String       @unique @map("ticket_number")
  bookingCode     String       @unique @map("booking_code")
  userId          String       @map("user_id")
  drawId          String       @map("draw_id")
  totalStakeMinor BigInt       @map("total_stake_minor")
  potentialPayout BigInt?      @map("potential_payout_minor")
  status          TicketStatus @default(PENDING)
  createdAt       DateTime     @default(now()) @map("created_at")

  user  User         @relation(fields: [userId], references: [id])
  draw  Draw         @relation(fields: [drawId], references: [id])
  lines TicketLine[]

  @@map("tickets")
}

model TicketLine {
  id             String @id @default(uuid())
  ticketId       String @map("ticket_id")
  gameTypeId     String @map("game_type_id")
  lineStakeMinor BigInt @map("line_stake_minor")
  numbers        Json   @map("numbers")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_lines")
}

model Deposit {
  id            String                     @id @default(uuid())
  userId        String                     @map("user_id")
  walletId      String                     @map("wallet_id")
  transactionId String?                    @unique @map("transaction_id")
  provider      String
  externalRef   String?                    @map("external_ref")
  amountMinor   BigInt                     @map("amount_minor")
  status        FinancialTransactionStatus @default(PENDING)
  createdAt     DateTime                   @default(now()) @map("created_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("deposits")
}

model Withdrawal {
  id            String                     @id @default(uuid())
  userId        String                     @map("user_id")
  transactionId String?                    @unique @map("transaction_id")
  provider      String
  externalRef   String?                    @map("external_ref")
  amountMinor   BigInt                     @map("amount_minor")
  status        FinancialTransactionStatus @default(PENDING)
  createdAt     DateTime                   @default(now()) @map("created_at")

  user        User                 @relation(fields: [userId], references: [id])
  transaction FinancialTransaction? @relation(fields: [transactionId], references: [id])

  @@map("withdrawals")
}

// ==========================================
// ADMIN & RBAC MODELS
// ==========================================

model AdminUser {
  id           String   @id @default(uuid())
  phoneNumber  String   @unique @map("phone_number") // Updated from email to match phone auth
  passwordHash String   @map("password_hash")
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  roles     AdminUserRole[]
  auditLogs AuditLog[]

  @@map("admin_users")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       AdminUserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  action      String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model AdminUserRole {
  adminUserId String @map("admin_user_id")
  roleId      String @map("role_id")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id          String   @id @default(uuid())
  adminUserId String?  @map("admin_user_id")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  payload     Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  @@map("audit_logs")
}

// ==========================================
// RESPONSIBLE GAMING & SYSTEM SETTINGS
// ==========================================

model ResponsibleGamingLimit {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  limitType   String   @map("limit_type") // DAILY_DEPOSIT, MONTHLY_STAKE, etc.
  amountMinor BigInt   @map("amount_minor")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("responsible_gaming_limits")
}

model SelfExclusion {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  reason    String?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("self_exclusions")
}

model SystemSetting {
  key         String   @id
  value       String
  
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}